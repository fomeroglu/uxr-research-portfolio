// ── CLUSTER: ResourceTokens (Supply) ─────────────────────────────

Table ZONES {
  id int [pk]
  name varchar [not null]
  zip5 char [not null]
  is_gateway bool [not null]
  is_pickup bool [not null]
  is_dropoff bool [not null]
  is_storage bool [not null]
  geofence_center_lat float [not null]
  geofence_center_lng float [not null]
  geofence_radius_m float [not null]
}

Table LANES {
  id int [pk]
  origin_zone_id int [not null, ref: > ZONES.id]
  destination_zone_id int [not null, ref: > ZONES.id]
}

Table TRIPS {
  id int [pk]
  lane_id int [not null, ref: > LANES.id]
  start_at datetime [not null]
  end_at datetime [not null]
  qty_total int [not null]
  qty_available int [not null]
}

Table STAY_WINDOWS {
  id int [pk]
  storage_zone_id int [not null, ref: > ZONES.id]
  start_at datetime [not null]
  end_at datetime [not null]
  qty_total int [not null]
  qty_available int [not null]

  Note: 'ZoneListingWindow'
}

Table CAPACITY_TOKENS {
  id int [pk]
  context_type varchar [not null, note: 'MOVING | STATIONARY']
  trip_id int [null, ref: > TRIPS.id]
  stay_window_id int [null, ref: > STAY_WINDOWS.id]
  qty_total int [not null]
  qty_available int [not null]
  status varchar [not null, note: 'AVAILABLE | RESERVED | MATERIALIZED | RELEASED']
  price_cents int [not null]
  currency varchar [not null, default: 'USD']

  Note: 'CHECK: trip_id XOR stay_window_id (exactly one must be set)'
}

// ── CLUSTER: Transactions ─────────────────────────────────────────

Table ORGS {
  id int [pk]
  name varchar [not null]
}

Table BOOKINGS {
  id int [pk, note: 'Reservation ID — shown to users']
  buyer_org_id int [not null, ref: > ORGS.id]
  supplier_org_id int [not null, ref: > ORGS.id]
  status varchar [not null, note: 'PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED']

  Note: 'buyer_org_id != supplier_org_id'
}

Table ALLOCATIONS {
  id int [pk, note: 'internal only']
  booking_id int [not null, ref: > BOOKINGS.id]
  capacity_token_id int [not null, ref: > CAPACITY_TOKENS.id]
  qty_reserved int [not null]
  leg_sequence int [not null]
  holder_org_id int [not null, ref: > ORGS.id, note: 'v1 = buyer_org_id']
  parent_allocation_id int [null, ref: > ALLOCATIONS.id]
  status varchar [not null, note: 'RESERVED | MATERIALIZED | RELEASED | TRANSFERRED']
}

// ── CLUSTER: LiabilityTokens (Demand) ────────────────────────────

Table HANDLING_UNIT_GROUPS {
  id int [pk]
  booking_id int [not null, ref: > BOOKINGS.id]
  group_number int [not null]
  leg_sequence int [not null]
  parent_group_id int [null, ref: > HANDLING_UNIT_GROUPS.id]
  status varchar [not null, note: 'SCHEDULED | IN_PROGRESS | COMPLETED | PARTIALLY_COMPLETED | DELAYED | BLOCKED | INCOMPLETE']

  Note: 'leg_sequence matches ALLOCATIONS.leg_sequence'
}

Table HANDLING_UNITS {
  id int [pk, note: 'BOL number — shown to users']
  handling_unit_group_id int [not null, ref: > HANDLING_UNIT_GROUPS.id]
  status varchar [not null, note: 'CREATED | READY | IN_TRANSIT | STAGED | OUT_FOR_DELIVERY | ARRIVED | DELIVERED | EXCEPTION']
  last_seen_zone_id int [null, ref: > ZONES.id]
  last_seen_at_utc datetime [null]

  Note: 'Group last_seen derived by aggregating unit last_seen_*'
}

// ── CLUSTER: Proof ────────────────────────────────────────────────

Table SCAN_EVENT_TYPES {
  code varchar [pk]
  description text [not null]
}

Table SCAN_EVENTS {
  id int [pk]
  handling_unit_id int [not null, ref: > HANDLING_UNITS.id]
  event_type_code varchar [not null, ref: > SCAN_EVENT_TYPES.code]
  occurred_at_utc datetime [not null]
  user_id int [not null, note: 'FK -> USERS.id (external auth service)']
  zone_id int [not null, ref: > ZONES.id]
  lat float [not null]
  lng float [not null]

  Note: 'APPEND-ONLY. Geo hard-fail enforced at API. Destination trigger: DroppedOffAtDestination'
}

Table EVIDENCE_ASSETS {
  id int [pk]
  scan_event_id int [not null, ref: > SCAN_EVENTS.id]
  kind varchar [not null, note: 'PHOTO']
  url text [not null]

  Note: 'Required for exception scan types (e.g. Damaged, Short)'
}

// ── TABLE GROUPS (visual clusters) ───────────────────────────────

TableGroup supply {
  ZONES
  LANES
  TRIPS
  STAY_WINDOWS
  CAPACITY_TOKENS
}

TableGroup transactions {
  ORGS
  BOOKINGS
  ALLOCATIONS
}

TableGroup demand {
  HANDLING_UNIT_GROUPS
  HANDLING_UNITS
}

TableGroup proof {
  SCAN_EVENT_TYPES
  SCAN_EVENTS
  EVIDENCE_ASSETS
}

